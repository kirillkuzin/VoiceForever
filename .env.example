# --- Telegram -------------------------------------------------------------
# Token from @BotFather
VF_TELEGRAM_TOKEN=
# Who may use the bot and which agent token belongs to them:
#   <telegram user id>:<agent token>[,<id>:<token>...]
# Your Telegram ID: send /start to the bot. Make a token: python -c "import secrets;print(secrets.token_urlsafe(32))"
VF_USERS=

# --- Speech-to-text (any OpenAI-compatible /audio/transcriptions API) -------
# OpenAI (default):        https://api.openai.com/v1           gpt-4o-mini-transcribe | gpt-4o-transcribe
# Groq:                    https://api.groq.com/openai/v1      whisper-large-v3-turbo
# Self-hosted (speaches):  http://speaches:8000/v1             Systran/faster-whisper-large-v3
VF_STT_BASE_URL=https://api.openai.com/v1
VF_STT_API_KEY=
VF_STT_MODEL=gpt-4o-mini-transcribe
VF_STT_LANGUAGE=ru
# Extra words to help recognition (optional)
VF_STT_PROMPT=

# --- Claude: picks the chat channel, fixes punctuation, optional rewriting ---
ANTHROPIC_API_KEY=
VF_LLM_ENABLED=true
VF_LLM_MODEL=claude-opus-5-5
VF_LLM_EFFORT=low
# /style command (rewrite messages in a style or translate). Planned paid feature in the hosted version.
VF_ALLOW_TRANSFORM=true
# Character names you mention often, shared by all users (users can add their own with /names)
VF_KNOWN_NAMES=

# --- Misc ------------------------------------------------------------------
VF_MAX_MESSAGE_BYTES=255
VF_ACK_TIMEOUT_S=30
