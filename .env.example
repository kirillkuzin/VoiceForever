# --- Telegram -------------------------------------------------------------
# Token from @BotFather. Empty: no bot, only the Windows app
VF_TELEGRAM_TOKEN=
# Who may use the bot and which agent token belongs to them:
#   <telegram user id>:<agent token>[,<id>:<token>...]
# Your Telegram ID: send /start to the bot. Make a token: python -c "import secrets;print(secrets.token_urlsafe(32))"
VF_USERS=

# --- Accounts from your own service instead of VF_USERS (docs/access-api.md) ---
# VF_ACCESS_URL=http://accounts:8080/access
# VF_ACCESS_SECRET=
# VF_ACCESS_TIMEOUT_S=2
# Answers to /terms and /paysupport when the bot sells a subscription (/buy)
# VF_TERMS_URL=
# VF_PAY_SUPPORT=

# --- Speech-to-text (any OpenAI-compatible /audio/transcriptions API) -------
# OpenAI (default):        https://api.openai.com/v1           gpt-4o-mini-transcribe | gpt-4o-transcribe
# Groq:                    https://api.groq.com/openai/v1      whisper-large-v3-turbo
# Self-hosted (speaches):  http://speaches:8000/v1             Systran/faster-whisper-large-v3
#   published on the host: http://host.docker.internal:8000/v1  (API key can stay empty)
VF_STT_BASE_URL=https://api.openai.com/v1
VF_STT_API_KEY=
VF_STT_MODEL=gpt-4o-mini-transcribe
# Empty: the model detects the spoken language. Set a code (ru, en, de...) to lock it.
# With VF_ACCESS_URL, a language the player set on their account wins over this one.
VF_STT_LANGUAGE=
# Game words that help recognition (optional). Empty: a built-in list in the player's language
VF_STT_PROMPT=

# --- Claude: picks the chat channel, fixes punctuation, optional rewriting ---
ANTHROPIC_API_KEY=
VF_LLM_ENABLED=true
# claude-opus-5-5 is the most accurate; claude-haiku-5-5 is cheaper and faster
VF_LLM_MODEL=claude-opus-5-5
VF_LLM_EFFORT=low
# /style command (rewrite messages in a style or translate). Planned paid feature in the hosted version.
VF_ALLOW_TRANSFORM=true
# Character names you mention often, shared by all users (users can add their own with /names)
VF_KNOWN_NAMES=
# "Download the agent" button in the Telegram setup checklist (/start)
# VF_AGENT_DOWNLOAD_URL=https://github.com/kirillkuzin/VoiceForever/releases/latest

# --- Misc ------------------------------------------------------------------
# Docker image for docker-compose.yml (default: ghcr.io/kirillkuzin/voiceforever-server:latest)
# VF_IMAGE=ghcr.io/kirillkuzin/voiceforever-server:0.2
VF_MAX_MESSAGE_BYTES=255
VF_ACK_TIMEOUT_S=30
# Longest recording the agent may send from the gamepad, in seconds
VF_MAX_VOICE_S=60
# Messages per player per minute, voice and text together (0 = no limit)
VF_RATE_PER_MIN=20
